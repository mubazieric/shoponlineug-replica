# Copy this file to .env and adjust as needed.

PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string
MAIL_FROM=ShopOnlineUg <no-reply@shoponline.ug>

# --- Email delivery -------------------------------------------------------
# Leave SMTP_HOST blank to automatically use a free Ethereal test inbox.
# Every email is ALWAYS also copied to the in-app mailbox (API: /api/dev/outbox),
# so the confirmation code and link are visible even with no SMTP configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
USE_ETHEREAL=true

# --- Google sign-in (optional) -------------------------------------------
# Without these, the app shows a local "Choose an account" Google chooser so
# the sign-in flow still works end to end.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
