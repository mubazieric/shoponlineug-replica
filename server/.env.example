# Copy to server/.env for local runs, or set these as environment variables
# in your host (Railway > Variables). All are optional for a basic deploy.

# HTTP port (hosts usually inject PORT automatically).
PORT=3000

# Secret used to sign auth cookies/JWTs. SET THIS IN PRODUCTION.
JWT_SECRET=change-me-to-a-long-random-string

# Persistent state. In Docker these default to /data and /data/uploads.
# SOU_DATA_DIR=/data
# SOU_UPLOAD_DIR=/data/uploads

# Outbound email (verification codes). Without SMTP the app logs codes only.
# USE_ETHEREAL=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ShopOnlineUg <no-reply@shoponline.ug>
